# Copy to .env for local overrides. Every value has a working default.

# SQLite is the default so the demo runs with no setup. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://matooke:matooke@localhost:5432/matookesmart
DATABASE_URL=sqlite:///./data/matookesmart.db

# Build the demo dataset on first start (all values are synthetic).
SEED_DEMO_DATA=true

# Responsible-AI thresholds. Lowering these makes the app answer more often -
# do not lower them to make a demo look smarter.
DISEASE_REFERRAL_CONFIDENCE=0.45
FORECAST_LOW_CONFIDENCE_MAPE=0.20
FORECAST_HIGH_CONFIDENCE_MAPE=0.10
MIN_RECORDS_FOR_FORECAST=40

# Commercial hypotheses (to be validated with farmers, not shipped as tariffs)
DEFAULT_COMMISSION_PCT=3.0
DEFAULT_DEPOSIT_PCT=25.0
MIN_ATTRACTIVE_MARGIN_PCT=15.0
